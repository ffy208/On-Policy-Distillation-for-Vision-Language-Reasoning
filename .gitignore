# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets and local environment
.env
.env.*
settings.json
*.pem
*.key

# Large files and caches (models, data, checkpoints all live on the HuggingFace Hub, not in git)
hf_cache/
ckpt/
data/
*.safetensors
*.bin
*.pt

# Temporary files
temp/
.ipynb_checkpoints/
.DS_Store

# Outputs: every result is pushed to the Hub results repo, so nothing under outputs/ is tracked
outputs/*
!outputs/.gitkeep

# Claude Code session logs
.claude/logs/
.claude/session-context-*.md

# Slurm / experiment logs
logs/
